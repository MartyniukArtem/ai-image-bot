    {
      "parameters": {
        "jsCode": "const promptId = $('ComfyUI Generate').first().json.prompt_id;\nconst historyData = $input.first().json;\nconst chatId = $('Extract Image Prompt').first().json.chatId;\n\n// Перевірка чи є дані\nif (!historyData || !historyData[promptId]) {\n  return [{\n    json: {\n      error: true,\n      chatId: chatId,\n      message: \"❌ Помилка генерації. Спробуйте ще раз через хвилину.\"\n    }\n  }];\n}\n\nconst promptData = historyData[promptId];\n\n// Перевірка чи генерація завершена\nif (!promptData.outputs) {\n  return [{\n    json: {\n      error: true,\n      chatId: chatId,\n      message: \"⏳ Генерація ще не завершена. Спробуйте через 30 секунд.\"\n    }\n  }];\n}\n\n// Витягуємо filename\nconst output = promptData.outputs;\nconst imageNode = Object.values(output).find(node => node.images);\n\nif (!imageNode || !imageNode.images || !imageNode.images[0]) {\n  return [{\n    json: {\n      error: true,\n      chatId: chatId,\n      message: \"❌ Зображення не знайдено. Спробуйте ще раз.\"\n    }\n  }];\n}\n\nconst filename = imageNode.images[0].filename;\n\nreturn [{\n  json: {\n    error: false,\n    filename: filename,\n    chatId: chatId\n  }\n}];"
      },
