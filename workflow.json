        "jsCode": "const claudeResponse = $input.first().json.content[0].text;\nconst chatId = parseInt($('Telegram Trigger').first().json.message.chat.id);\n\n// Додаємо відповідь Claude до історії\nconst staticData = $getWorkflowStaticData('global');\nstaticData[`history_${chatId}`].push({\n  role: \"assistant\",\n  content: claudeResponse\n});\n\nreturn [{\n  json: {\n    answer: claudeResponse,\n    chatId: chatId\n  }\n}];"
