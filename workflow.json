        "jsCode": "const chatId = $input.first().json.message.chat.id;\nconst userMessage = $input.first().json.message.text;\n\n// Отримуємо staticData\nconst staticData = $getWorkflowStaticData('global');\n\n// Ініціалізуємо історію для цього chatId якщо її немає\nif (!staticData[`history_${chatId}`]) {\n  staticData[`history_${chatId}`] = [];\n}\n\n// Додаємо повідомлення користувача до історії\nstaticData[`history_${chatId}`].push({\n  role: \"user\",\n  content: userMessage\n});\n\n// Зберігаємо chatId як раніше\nstaticData.lastChatId = chatId;\n\nreturn $input.all();"
